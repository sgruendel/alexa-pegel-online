{
    "name": "alexa-pegel-online",
    "version": "2.24.0",
    "description": "Alexa Skill for interacting with http://www.pegelonline.wsv.de",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "reinstall": "rm -rf ./node_modules && npm install",
        "create-model": "node create-model.js",
        "test:unit": "node --env-file-if-exists=.env ./node_modules/c8/bin/c8.js --reporter=lcov --reporter=text mocha --timeout=7000 --file test/setup.js test/unit/*",
        "test:integration": "node --env-file-if-exists=.env ./node_modules/mocha/bin/mocha.js --timeout=20000 test/integration/*",
        "test": "npm run test:unit",
        "lambda:zip": "zip -r /tmp/pegelOnline.zip node_modules/ package* *.js *.json",
        "lambda:deploy": "npm run lambda:zip && aws lambda update-function-code --function-name pegelOnline --zip-file fileb:///tmp/pegelOnline.zip",
        "model:deploy": "node --env-file-if-exists=.env scripts/deploy-model.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sgruendel/alexa-pegel-online.git"
    },
    "author": "Stefan Gründel",
    "license": "GPL-3.0",
    "bugs": {
        "url": "https://github.com/sgruendel/alexa-pegel-online/issues"
    },
    "homepage": "https://github.com/sgruendel/alexa-pegel-online#readme",
    "dependencies": {
        "ask-sdk-core": "^2.14.0",
        "ask-sdk-model": "^1.86.0",
        "i18next": "^26.4.1",
        "i18next-sprintf-postprocessor": "^0.2.2",
        "node-fetch": "^3.3.2",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.13.3",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "eslint": "^10.9.1",
        "globals": "^17.12.0",
        "mocha": "^12.0.0",
        "nock": "^14.0.17"
    }
}
